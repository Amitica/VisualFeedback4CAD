{
  "name": "cadgenbench-pi",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
	"bin": {
		"cadgenbench-pi": "dist/src/cli.js",
		"cadgenbench-pi-drawing-search": "dist/src/drawing-search-cli.js",
		"cadgenbench-pi-reflection-only": "dist/src/drawing-reflection-only-cli.js",
		"cadgenbench-pi-reflection-refine-session": "dist/src/drawing-reflection-refinement-cli.js",
		"cadgenbench-pi-reflection-accept": "dist/src/drawing-reflection-acceptance-cli.js",
		"cadgenbench-pi-reflection-continue": "dist/src/drawing-reflection-continuation-cli.js",
		"cadgenbench-pi-drawing-scale-agent": "dist/src/drawing-scale-agent-cli.js",
		"cadgenbench-pi-main-self-reflect-continue": "dist/src/main-self-reflect-continuation-cli.js",
		"cadgenbench-pi-main-view-reflect-continue": "dist/src/main-view-reflect-continuation-cli.js"
	},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "image:build": "docker build --file docker/Dockerfile --tag cadgenbench-pi-agent:0.5.0 ../..",
		"image:build:main-view-reflect": "docker build --file docker/Dockerfile --tag cadgenbench-pi-agent:0.5.0-main-view-reflect-v1 ../.."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
